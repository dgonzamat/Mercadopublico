{
  "name": "uap-analysis-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/validate-schema.mjs --warn && node scripts/build-cases.mjs && node scripts/build-maps.mjs && node scripts/build-posts.mjs && node scripts/build-rss.mjs && node scripts/build-search-index.mjs && node scripts/audit-consistency.mjs --warn && next dev",
    "prebuild": "node scripts/validate-schema.mjs && node scripts/build-cases.mjs && node scripts/build-maps.mjs && node scripts/build-posts.mjs && node scripts/build-rss.mjs && node scripts/build-search-index.mjs && node scripts/audit-consistency.mjs && node scripts/audit-design.mjs",
    "build": "next build",
    "postbuild": "node scripts/test-chart.mjs",
    "test": "node scripts/test-chart.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "audit": "node scripts/audit-consistency.mjs",
    "deuda": "node scripts/debt-report.mjs",
    "audit:prosa": "node scripts/audit-prosa.mjs",
    "audit-design": "node scripts/audit-design.mjs",
    "audit-skills": "node scripts/audit-skills.mjs",
    "qa:shots": "node scripts/qa-screenshots.mjs",
    "qa:shots:mobile": "node scripts/qa-screenshots.mjs --mobile",
    "check-links": "node scripts/check-links.mjs",
    "check-links:gate": "node scripts/check-links.mjs --baseline --timeout 12",
    "check-links:baseline": "node scripts/check-links.mjs --update-baseline --timeout 12",
    "check-dvids": "node scripts/check-dvids-embeds.mjs",
    "validate-schema": "node scripts/validate-schema.mjs",
    "lint": "eslint .",
    "wayback": "node scripts/suggest-wayback.mjs",
    "wayback:apply": "node scripts/suggest-wayback.mjs --apply",
    "qa:interaction": "node scripts/qa-interaction.mjs",
    "qa:relato": "node scripts/qa-relato.mjs",
    "sondas:frenos": "node scripts/probe-hits-report.mjs",
    "caso:check": "node scripts/caso-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "2.1.1",
    "fuse.js": "7.5.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-pdf": "^9.2.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.6.1",
    "d3-geo": "3.1.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "topojson-client": "3.1.0",
    "typescript": "5.6.3",
    "us-atlas": "3.0.1",
    "world-atlas": "2.0.2"
  },
  "overrides": {
    "postcss": "8.5.31"
  },
  "browserslist": [
    "last 2 years",
    "not dead",
    "not op_mini all"
  ]
}
