{
  "name": "uap-analysis-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/validate-schema.mjs --warn && node scripts/build-cases.mjs && node scripts/build-posts.mjs && node scripts/build-rss.mjs && node scripts/build-search-index.mjs && node scripts/audit-consistency.mjs --warn && next dev",
    "prebuild": "node scripts/validate-schema.mjs && node scripts/build-cases.mjs && node scripts/build-posts.mjs && node scripts/build-rss.mjs && node scripts/build-search-index.mjs && node scripts/audit-consistency.mjs && node scripts/audit-design.mjs",
    "build": "next build",
    "postbuild": "node scripts/test-chart.mjs",
    "test": "node scripts/test-chart.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "audit": "node scripts/audit-consistency.mjs",
    "audit-design": "node scripts/audit-design.mjs",
    "audit-skills": "node scripts/audit-skills.mjs",
    "qa:shots": "node scripts/qa-screenshots.mjs",
    "qa:shots:mobile": "node scripts/qa-screenshots.mjs --mobile",
    "check-links": "node scripts/check-links.mjs",
    "check-links:gate": "node scripts/check-links.mjs --baseline --timeout 12",
    "check-links:baseline": "node scripts/check-links.mjs --update-baseline --timeout 12",
    "check-dvids": "node scripts/check-dvids-embeds.mjs",
    "validate-schema": "node scripts/validate-schema.mjs",
    "lint": "eslint .",
    "wayback": "node scripts/suggest-wayback.mjs",
    "wayback:apply": "node scripts/suggest-wayback.mjs --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "2.1.1",
    "fuse.js": "7.0.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "leaflet": "1.9.4",
    "next": "16.2.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-pdf": "^9.2.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "browserslist": [
    "last 2 years",
    "not dead",
    "not op_mini all"
  ]
}
