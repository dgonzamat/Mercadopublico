<?xml version="1.0" encoding="utf-8"?>
<com.dgonzamat.limpiador.SquareCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:checkedIcon="@drawable/ic_check_circle"
    app:checkedIconGravity="TOP_END"
    app:checkedIconMargin="6dp"
    app:checkedIconSize="26dp"
    app:checkedIconTint="?attr/colorPrimary"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="0dp">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceVariant"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scrim"
        android:ellipsize="end"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@android:color/white"
        tools:text="1,2 MB" />
</com.dgonzamat.limpiador.SquareCardView>
